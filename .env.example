APP_ENV=development
DEBUG=true

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

LLM_API_KEY=

MODEL_STORAGE_PATH=

RAG_VECTOR_DB_PATH=./rag/vectorstore

UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs


# "real" runs the ML pipeline (needs weights, vector index and GEMINI_API_KEY).
# "mock" returns fake results instantly-ish and needs none of that.
PIPELINE_MODE=real

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Where cases, results and the SQLite DB live (relative paths are from the repo root).
DATA_DIR=./data

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

MAX_UPLOAD_MB=500
# A job running longer than this is killed and marked failed (CPU-only runs are slow).
JOB_TIMEOUT_SECONDS=1800
# Finished cases are deleted after this many days.
RETENTION_DAYS=7
LOG_LEVEL=INFO

# Mock mode only: fake processing time, and force every job to fail (to test error UI).
MOCK_DELAY_SECONDS=3
MOCK_FAIL=false

# Required in real mode (report generation).
GEMINI_API_KEY=